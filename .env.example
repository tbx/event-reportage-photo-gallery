# Copy to .env (not committed). Same names as the GitHub Secrets/Variables.
SFTP_HOST=sftp.example.com
SFTP_USER=
SFTP_PASSWORD=
# optional:
SFTP_PORT=22
# remote folder, default: basePath from gallery.config.json without the leading slash
SFTP_REMOTE_DIR=gallery
# source folder with your full-resolution photos (numbered file names) for `npm run photos`
# default: demo-photos/ (or photos-src/ if it exists)
#PHOTOS_SRC=/path/to/your/photos
